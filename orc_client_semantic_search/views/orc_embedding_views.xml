<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Settings → Technical → AI Semantic Search.

        The page renders the global singleton's provider fields in
        a header section and the per-model toggle list as a tree.
        "Test provider" + "Reindex all" are buttons on the global
        form.
    -->

    <record id="view_orc_embedding_config_form" model="ir.ui.view">
        <field name="name">orc.embedding.config.form</field>
        <field name="model">orc.embedding.config</field>
        <field name="arch" type="xml">
            <form string="AI Semantic Search Config">
                <header>
                    <button name="action_test_provider"
                            type="object"
                            string="Test provider"
                            class="btn-primary"
                            invisible="not is_global"/>
                    <button name="action_reindex_all"
                            type="object"
                            string="Reindex all"
                            class="btn-secondary"
                            invisible="not is_global"
                            confirm="This will drop the index for every enabled model and re-embed every in-scope record. Costs money, and sends those records' text to the embedding provider. Run 'Preview scope' first if you are unsure how many that is. Continue?"/>
                    <button name="action_preview_scope"
                            type="object"
                            string="Preview scope"
                            class="btn-primary"
                            invisible="is_global"/>
                    <button name="action_sync_index_scope"
                            type="object"
                            string="Sync index scope"
                            class="btn-secondary"
                            invisible="is_global"
                            confirm="This deletes vectors for records that are now out of scope, and queues in-scope records that have none. The queued ones are sent to the embedding provider on the cron's next pass. Continue?"/>
                </header>
                <sheet>
                    <field name="is_global" invisible="1"/>
                    <group invisible="not is_global" string="Provider">
                        <field name="provider_kind"/>
                        <field name="provider_url"/>
                        <field name="provider_api_key" password="True"/>
                        <field name="provider_model"/>
                        <field name="vector_dim"/>
                        <field name="cron_interval_minutes"/>
                        <field name="daily_token_cap"/>
                        <field name="tokens_used_today"/>
                        <field name="tokens_usage_date"/>
                    </group>
                    <group invisible="is_global" string="Indexed model">
                        <field name="model_name"/>
                        <field name="enabled"/>
                        <field name="text_field_path"/>
                        <field name="text_extractor"/>
                    </group>
                    <group invisible="is_global" string="Index scope">
                        <div class="text-muted" colspan="2">
                            Which records of this model may have their text
                            sent to the embedding provider. An empty domain
                            means all of them. Use "Preview scope" before
                            widening.
                        </div>
                        <field name="index_domain" placeholder="[]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_orc_embedding_config_list" model="ir.ui.view">
        <field name="name">orc.embedding.config.list</field>
        <field name="model">orc.embedding.config</field>
        <field name="arch" type="xml">
            <list string="AI Semantic Search Config">
                <field name="is_global"/>
                <field name="model_name"/>
                <field name="enabled"/>
                <field name="index_domain"/>
                <field name="text_field_path"/>
                <field name="text_extractor"/>
                <field name="provider_model"/>
            </list>
        </field>
    </record>

    <record id="action_orc_embedding_config" model="ir.actions.act_window">
        <field name="name">AI Semantic Search</field>
        <field name="res_model">orc.embedding.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--
        The per-article opt-out, surfaced on knowledge.article's own
        list + search views.

        Both xpaths target the ROOT element rather than a named field
        or filter. Anchoring on, say, `last_edition_date` would tie
        this module's installability to one Enterprise `knowledge`
        layout, and a missing anchor is a hard install failure — on
        Odoo.sh that surfaces as a failed build, not a warning.

        The article FORM is deliberately left alone: it is a custom
        OWL layout built from `knowledge_topbar` /
        `knowledge_properties_panel` widgets, with no stable anchor
        for a plain checkbox. Toggling from the list view is enough
        for v1; a form placement needs someone who can render the
        Enterprise view and look at it.
    -->
    <record id="view_knowledge_article_list_ai_exclude" model="ir.ui.view">
        <field name="name">knowledge.article.list.orc.ai.exclude</field>
        <field name="model">knowledge.article</field>
        <field name="inherit_id" ref="knowledge.knowledge_article_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="orc_ai_index_exclude"
                       string="Excluded from AI index"
                       optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_knowledge_article_search_ai_exclude" model="ir.ui.view">
        <field name="name">knowledge.article.search.orc.ai.exclude</field>
        <field name="model">knowledge.article</field>
        <field name="inherit_id" ref="knowledge.knowledge_article_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_orc_ai_index_excluded"
                        string="Excluded from AI index"
                        domain="[('orc_ai_index_exclude', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_orc_embedding_root"
              name="AI Semantic Search"
              parent="base.menu_custom"
              action="action_orc_embedding_config"
              sequence="50"/>

</odoo>
